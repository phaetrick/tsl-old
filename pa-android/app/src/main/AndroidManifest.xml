<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.rocks.pocketanalog"
    android:installLocation="auto">
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <uses-feature android:name="android.software.midi" android:required="false"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- The trial gate's one round trip (TrialGate). Everything else the app does
         over a network goes through Play Services, which is why this was never
         needed before: without it every mint fails with a SecurityException and
         the whole trial degrades, silently, to capped sessions forever. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name="me.rocks.pocketanalog.MyApplication"
        android:theme="@style/MyActivity"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="false"
        android:label="@string/app_name">
        <activity
        android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/MyActivity.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="nativelib" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:launchMode="singleTask"
            android:parentActivityName=".MainSettings2"

            android:name=".EulaActivity"
            android:theme="@style/MyActivity"/>

        <activity
            android:parentActivityName=".MainSettings2"
            android:launchMode="singleTask"

            android:name=".InAppPurchases"
            android:theme="@style/MyActivity"/>
        <activity
            android:parentActivityName=".MainSettings2"
            android:name=".MidiActivity"
            android:launchMode="singleTask"

            android:theme="@style/MyAlertdialogtheme"/>
        <activity
            android:name=".MainSettings2"
            android:parentActivityName=".MainActivity"

            android:launchMode="singleTask"
            android:theme="@style/MyActivity"/>
        <service android:name=".MidiSynthDeviceService"
            android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.media.midi.MidiDeviceService" />
            </intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService"
                android:resource="@xml/grainstorm_device_info" />
        </service>

        <service
            android:name=".SynthService"
            android:enabled="true"
            android:exported="false"
            android:description="@string/fgs_description"
            android:foregroundServiceType="mediaPlayback" />

        <receiver android:name=".MyBroadcastReceiver" android:exported="true">
            <intent-filter>
                <action android:name="Power Off" />
            </intent-filter>
        </receiver>
    </application>
</manifest>