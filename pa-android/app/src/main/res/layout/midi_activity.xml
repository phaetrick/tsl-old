<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   style="@style/dialogParentStyle"
    >
    <TextView
        android:id="@+id/text_receivers"
        style="@style/SettingsTextviewTitle"
        android:text="Select MIDI Source"
        />
    <View
        android:layout_height="24dp"
        android:layout_width="match_parent"/>
    <Spinner
        android:id="@+id/spinner_synth_sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:entries="@array/senders"
        android:textAppearance="@android:style/TextAppearance.Material.Medium"
    />
    <View
        android:layout_height="24dp"
        android:layout_width="match_parent"/>
    <TextView
        android:id="@+id/text_midi_status"
        style="@style/SettingsTextviewMulti"
        android:gravity="start"
        android:text="@string/midi_status_idle"
        />
</LinearLayout>