<?xml version="1.0" encoding="utf-8"?>
<!-- Layers generated by pa-iplug/scripts/mkandroidicons.py from the baked mark in
     CPP-New/va/icon_voltaic.cpp, so the launcher icon cannot drift from the logo
     the app draws itself. Regenerate rather than hand-editing the PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
