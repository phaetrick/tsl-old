<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyActivity" parent="Theme.Design.NoActionBar">
        <!-- your app branding color for the app bar -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- background and text -->
        <item name="android:windowBackground">@color/blackblack</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>

        <!-- full screen, no bars -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <item name="android:windowSplashScreenBackground">@android:color/black</item>

        <item name="postSplashScreenTheme">@style/MyActivity</item>

        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
</resources>

