<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.audio.input"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />
    <uses-feature
        android:name="android.software.midi"
        android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="me.rocks.grainstormunlocker.READPERMISSION" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name="me.rocks.grainstorm.MyApplication"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_foreground"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="false"
        android:theme="@style/MyActivity"
        android:allowAudioPlaybackCapture="false"
        tools:targetApi="33">
    <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
        android:theme="@style/MyActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="grainstorm" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.gsp" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EulaActivity"
            android:launchMode="singleTask"
            android:parentActivityName=".MainSettings2"
            android:theme="@style/MyActivity" />

        <activity
            android:name=".InAppPurchases"
            android:launchMode="singleTask"
            android:parentActivityName=".MainSettings2"
            android:theme="@style/MyActivity" />
        <activity
            android:name=".MidiActivity"
            android:launchMode="singleTask"
            android:parentActivityName=".MainSettings2"
            android:theme="@style/MyAlertdialogtheme" />
        <activity
            android:name=".PresetActivity"
            android:parentActivityName=".MainActivity"
            android:theme="@style/MyActivity" />
        <activity
            android:name=".MainSettings2"
            android:launchMode="singleTask"
            android:parentActivityName=".MainActivity"
            android:theme="@style/MyActivity" />

        <service
            android:name=".MidiSynthDeviceService"
            android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.media.midi.MidiDeviceService" />
            </intent-filter>
            <meta-data
                android:name="android.media.midi.MidiDeviceService"
                android:resource="@xml/grainstorm_device_info" />
        </service>
        <service
            android:name="me.rocks.grainstorm.SynthService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This app is a synthesizer/ sampler/ musical instrument. It is controllable by external devices like MIDI controllers - also when in background. There is a power button which turns on its dsp/sound engine. The user can optionally choose to start this foreground service when the sound engine gets powered on to prevent the system from destroying the app when it is in background." />
        </service>

        <service
            android:name="me.rocks.grainstorm.MicrophoneService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

        <receiver
            android:name=".MyBroadcastReceiver"
            android:exported="false"/>
    </application>
</manifest>